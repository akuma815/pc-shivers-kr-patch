  "entries": [
    {
      "entry_id": 1,
      "heap_offset": 90,
      "raw_hex": "2054686973206461726520776173206B696E64206F6620796F7572206964656120796F75206B6E6F772C206275742049276D20676C61642049276D206D65206F7574206865726520616E64206E6F7420796F7520696E2074686572652E",
      "source": " This dare was kind of your idea you know, but I'm glad I'm me out here and not you in there.",
      "ko": "이 내기는 네가 낸 생각이었잖아. 그래도 안에 있는 게 내가 아니라 너라서 다행이야.",
      "status": "needs_human_review",
      "timing": {
        "start_frame": 142,
