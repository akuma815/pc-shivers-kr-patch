+bool GfxFrameout::loadAudioSubtitle(uint16 resourceId, Common::String &text, uint32 &durationMillis) {
+	Common::File file;
+	if (!file.open("audio_subtitles_ko.csv")) {
+		debug(1, "[ShiversAudioSubtitle] audio_subtitles_ko.csv was not found");
+		return false;
+	}
+
+	while (!file.eos()) {
+		Common::String line = file.readLine();
+		line.trim();
+		if (line.empty() || line[0] == '#')
+			continue;
+
+		const size_t firstComma = line.find(',');
+		if (firstComma == Common::String::npos)
+			continue;
+		const size_t secondComma = line.find(',', firstComma + 1);
+		if (secondComma == Common::String::npos)
+			continue;
+
+		const uint32 parsedResourceId = (uint32)strtoul(line.substr(0, firstComma).c_str(), nullptr, 10);
+		if (parsedResourceId != resourceId)
+			continue;
+
+		durationMillis = (uint32)strtoul(line.substr(firstComma + 1, secondComma - firstComma - 1).c_str(), nullptr, 10);
+		text = line.substr(secondComma + 1);
+		if (durationMillis == 0 || text.empty()) {
+			warning("[ShiversAudioSubtitle] Invalid row for audio resource %u", resourceId);
+			return false;
+		}
+		return true;
+	}
+
+	debug(1, "[ShiversAudioSubtitle] No subtitle row for audio resource %u", resourceId);
+	return false;
+}
+
+void GfxFrameout::showAudioSubtitle(uint16 resourceId) {
+	if (g_sci->getGameId() != GID_SHIVERS || g_sci->getLanguage() != Common::KO_KOR)
+		return;
+
+	Common::String text;
+	uint32 durationMillis = 0;
+	if (!loadAudioSubtitle(resourceId, text, durationMillis))
+		return;
+
+	if (_audioSubtitleFont == nullptr) {
+		Common::File *fontFile = new Common::File();
+		if (!fontFile->open("ShiversKorean.ttf")) {
+			delete fontFile;
+			warning("[ShiversAudioSubtitle] ShiversKorean.ttf was not found");
+			return;
+		}
+		_audioSubtitleFont = Graphics::loadTTFFont(fontFile, DisposeAfterUse::YES, 16,
+			Graphics::kTTFSizeModeCell, 0, 0, Graphics::kTTFRenderModeMonochrome);
+		if (_audioSubtitleFont == nullptr) {
+			warning("[ShiversAudioSubtitle] ShiversKorean.ttf could not be loaded");
+			return;
+		}
+		debug(1, "[ShiversAudioSubtitle] FONT ShiversKorean.ttf cell=16 height=%d UTF-8", _audioSubtitleFont->getFontHeight());
+	}
+
+	_audioSubtitleText = Common::U32String(text, Common::kUtf8);
+	_audioSubtitleResourceId = resourceId;
+	_audioSubtitleStartMillis = g_system->getMillis();
+	_audioSubtitleEndMillis = _audioSubtitleStartMillis + durationMillis;
+	_audioSubtitleActive = true;
+	debug(1, "[ShiversAudioSubtitle] START resource=%u duration_ms=%u", resourceId, durationMillis);
+}
+
+void GfxFrameout::clearAudioSubtitle(uint16 resourceId) {
+	if (!_audioSubtitleActive)
+		return;
+	if (resourceId != 0 && resourceId != _audioSubtitleResourceId)
+		return;
+
+	debug(1, "[ShiversAudioSubtitle] CLEAR resource=%u", _audioSubtitleResourceId);
+	_audioSubtitleActive = false;
+	_audioSubtitleResourceId = 0;
+	_audioSubtitleStartMillis = 0;
+	_audioSubtitleEndMillis = 0;
+	_audioSubtitleText.clear();
+}
+
+void GfxFrameout::restoreAudioSubtitleBackground() {
+	if (!_audioSubtitleDrawn)
+		return;
+
+	_currentBuffer.copyRectToSurface(
+		_audioSubtitleBackup,
+		_audioSubtitleRect.left,
+		_audioSubtitleRect.top,
+		Common::Rect(_audioSubtitleBackup.w, _audioSubtitleBackup.h)
+	);
+	_showList.add(_audioSubtitleRect);
+	_audioSubtitleDrawn = false;
+}
+
+void GfxFrameout::drawAudioSubtitle() {
+	if (!_audioSubtitleActive || _audioSubtitleFont == nullptr || _audioSubtitleText.empty())
+		return;
+
+	const int maxTextWidth = _currentBuffer.w - 16;
+	Common::Array<Common::Array<uint32> > lines;
+	Common::Array<int> lineWidths;
+	lines.push_back(Common::Array<uint32>());
+	lineWidths.push_back(0);
+	uint32 currentLine = 0;
+	for (size_t i = 0; i < _audioSubtitleText.size();) {
+		uint32 character = _audioSubtitleText[i++];
+		if (character == '\n') {
+			if (!lines[currentLine].empty()) {
+				lines.push_back(Common::Array<uint32>());
+				lineWidths.push_back(0);
+				++currentLine;
+			}
+			continue;
+		}
+		const int characterWidth = _audioSubtitleFont->getCharWidth(character);
+		if (lineWidths[currentLine] + characterWidth > maxTextWidth) {
+			lines.push_back(Common::Array<uint32>());
+			lineWidths.push_back(0);
+			++currentLine;
+			if (character == ' ')
+				continue;
+		}
+		lines[currentLine].push_back(character);
+		lineWidths[currentLine] += characterWidth;
+	}
+
+	const uint32 pageCount = (lines.size() + 1) / 2;
+	const uint32 durationMillis = _audioSubtitleEndMillis - _audioSubtitleStartMillis;
+	const uint32 elapsedMillis = g_system->getMillis() - _audioSubtitleStartMillis;
+	uint32 pageIndex = durationMillis == 0 ? 0 : (uint32)(((uint64)elapsedMillis * pageCount) / durationMillis);
+	if (pageIndex >= pageCount)
+		pageIndex = pageCount - 1;
+	const uint32 firstLine = pageIndex * 2;
+	const int remainingLines = (int)lines.size() - (int)firstLine;
+	const int lineCount = remainingLines > 2 ? 2 : remainingLines;
+	const int fontHeight = _audioSubtitleFont->getFontHeight();
+	const int rectHeight = lineCount * fontHeight + 4;
+	// Shivers' 640x480 gameplay view ends near y=360. Keep captions in the
+	// black band below it, above the inventory, with a stable top on every page.
+	const int subtitleTop = MIN(366, MAX(0, _currentBuffer.h - rectHeight));
+	_audioSubtitleRect = Common::Rect(4, subtitleTop, _currentBuffer.w - 4, subtitleTop + rectHeight);
+
+	if (_audioSubtitleBackup.w != _audioSubtitleRect.width() || _audioSubtitleBackup.h != _audioSubtitleRect.height()) {
+		_audioSubtitleBackup.free();
+		_audioSubtitleBackup.create(_audioSubtitleRect.width(), _audioSubtitleRect.height(), _currentBuffer.format);
+	}
+	_audioSubtitleBackup.copyRectToSurface(_currentBuffer, 0, 0, _audioSubtitleRect);
+
+	_currentBuffer.fillRect(_audioSubtitleRect, 0);
+	for (int lineIndex = 0; lineIndex < lineCount; ++lineIndex) {
+		const uint32 sourceLine = firstLine + lineIndex;
+		int x = (_currentBuffer.w - lineWidths[sourceLine]) / 2;
+		const int y = _audioSubtitleRect.top + 2 + lineIndex * fontHeight;
+		for (Common::Array<uint32>::const_iterator character = lines[sourceLine].begin(); character != lines[sourceLine].end(); ++character) {
+			_audioSubtitleFont->drawChar(&_currentBuffer, *character, x, y, 181);
+			x += _audioSubtitleFont->getCharWidth(*character);
+		}
+	}
+
+	_showList.add(_audioSubtitleRect);
+	_audioSubtitleDrawn = true;
+}
